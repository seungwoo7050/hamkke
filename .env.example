# 로컬 개발: docker compose up -d 로 기동한 Postgres에 연결.
# 실제 Supabase 프로젝트가 생기면 Supabase가 제공하는 연결 문자열로 교체만 하면 된다
# (docs/COMMIT_PLAN.md Phase 0 각주 참고).
DATABASE_URL="postgresql://hamkke:hamkke@localhost:5432/hamkke"

# --- Phase 1: 인증(Auth.js) ---

# JWT 서명/암호화 키, 32자 이상 랜덤 문자열. 생성: `npx auth secret` 또는 `openssl rand -base64 33`
AUTH_SECRET=""

# Google OAuth — https://console.cloud.google.com → OAuth 클라이언트 ID 생성(유형: 웹 애플리케이션)
# 승인된 리디렉션 URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# 이메일 매직링크 — Resend. resend.com 가입 후 API 키 발급.
# 도메인 인증 전엔 발신 주소가 onboarding@resend.dev로 고정되고, 이 주소는
# "Resend 계정 가입에 쓴 이메일"로만 발송 가능(테스트 전용). Gmail plus-addressing
# (me+a@gmail.com 등)으로 우회되는지는 미확인 — 실제로 안 되면 두 명 모두의 실제
# 이메일 주소로 테스트하거나, dev 환경에서만 발송 대신 매직링크를 서버 콘솔에
# 로그하는 방식(Phase 1 구현 시 결정)을 쓴다.
# 실제 도메인(예: hamkke.app)이 생기면 resend.com/domains에서 인증 후
# EMAIL_FROM을 그 도메인 주소로 교체.
AUTH_RESEND_KEY=""
EMAIL_FROM="onboarding@resend.dev"

# --- Phase 2: Supabase Realtime(채팅) ---
# 로컬 Postgres로는 Realtime을 흉내낼 수 없어 실제 Supabase 프로젝트가 필요하다.
# supabase.com → New Project 생성 후:
#
# 1) DATABASE_URL, DIRECT_URL — 프로젝트 대시보드 "Connect" 버튼에서 확인.
#    Supavisor Transaction 모드(포트 6543, ?pgbouncer=true 붙음) 문자열을
#    DATABASE_URL에, Session/Direct 모드(포트 5432) 문자열을 DIRECT_URL에.
#    둘 다 채우면 위 로컬 DATABASE_URL 값은 지우고 이 값으로 교체한다.
# 2) NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY —
#    프로젝트 Settings → API Keys에서 확인.
#    (주의: Supabase가 기존 anon/service_role 키 네이밍을 2026년 말까지
#    publishable/secret 키로 전환 중이다. 새 프로젝트는 새 네이밍 사용.)
# 3) SUPABASE_SECRET_KEY — 같은 페이지의 secret key. 서버(우리 Next.js
#    백엔드)에서 RLS를 우회해 브로드캐스트해야 할 때만 사용, 클라이언트에
#    노출 금지.
DIRECT_URL=""
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
