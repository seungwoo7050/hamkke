# 실제 Supabase 프로젝트의 direct 연결 문자열(포트 5432, pgbouncer 아님).
# Supabase 대시보드 "Connect" → Session/Direct 모드 문자열.
# Supavisor 풀링(6543, ?pgbouncer=true) 연결은 쓰지 않는다 - Prisma 7
# schema-engine의 CLI 연결 체크가 그 모드에서 무한 대기하는 문제가 있고,
# Hamkke는 2인 전용 앱이라 커넥션 풀링이 필요할 만큼 동접이 크지 않다
# (docs/ARCHITECTURE.md §8, prisma7.config.ts 주석 참고).
# 로컬 Postgres로 되돌리려면: docker compose up -d 후
# postgresql://hamkke:hamkke@localhost:5432/hamkke
DATABASE_URL=""

# 앱의 공개 주소(끝의 / 없이). 결제 후 돌아올 주소(Stripe success_url 등)를 만든다.
# 운영에선 반드시 넣는다(예: https://hamkke.app) - 비워 두면 요청의 Host 헤더로
# 만드는데, 그 값은 요청하는 쪽이 바꿀 수 있다. 로컬 개발은 비워 둬도 된다.
APP_URL=""

# --- Phase 1: 인증(Auth.js) ---

# JWT 서명/암호화 키, 32자 이상 랜덤 문자열. 생성: `npx auth secret` 또는 `openssl rand -base64 33`
AUTH_SECRET=""

# Google OAuth - https://console.cloud.google.com → OAuth 클라이언트 ID 생성(유형: 웹 애플리케이션)
# 승인된 리디렉션 URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# 이메일 매직링크 - Resend. resend.com 가입 후 API 키 발급.
# 도메인 인증 전엔 발신 주소가 onboarding@resend.dev로 고정되고, 이 주소는
# "Resend 계정 가입에 쓴 이메일"로만 발송 가능(테스트 전용). Gmail plus-addressing
# (me+a@gmail.com 등)으로 우회되는지는 미확인 - 실제로 안 되면 두 명 모두의 실제
# 이메일 주소로 테스트하거나, dev 환경에서만 발송 대신 매직링크를 서버 콘솔에
# 로그하는 방식(Phase 1 구현 시 결정)을 쓴다.
# 실제 도메인(예: hamkke.app)이 생기면 resend.com/domains에서 인증 후
# EMAIL_FROM을 그 도메인 주소로 교체.
AUTH_RESEND_KEY=""
EMAIL_FROM="onboarding@resend.dev"

# --- Phase 2: Supabase Realtime(채팅) ---
# 위 DATABASE_URL 발급과 같은 Supabase 프로젝트의 API 키.
# 1) NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY -
#    프로젝트 Settings → API Keys에서 확인.
#    (주의: Supabase가 기존 anon/service_role 키 네이밍을 2026년 말까지
#    publishable/secret 키로 전환 중이다. 새 프로젝트는 새 네이밍 사용.)
# 2) SUPABASE_SECRET_KEY - 같은 페이지의 secret key. 서버(우리 Next.js
#    백엔드)에서 RLS를 우회해 브로드캐스트해야 할 때만 사용, 클라이언트에
#    노출 금지.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
# 3) SUPABASE_JWT_PRIVATE_KEY - Realtime private 채널용 JWT 서명 키(비공개 JWK
#    한 줄). `npx tsx scripts/generate-supabase-jwt-key.mts`로 만들고, 같은 JWK를
#    Supabase → JWT Keys에 가져와 current로 둔다(README 배포 체크리스트). 비워 두면
#    Realtime은 공개 채널로 동작한다(전환 전 상태).
SUPABASE_JWT_PRIVATE_KEY=""

# --- Phase 2: Cloudflare R2(이미지/음성 메시지 업로드) ---
# dash.cloudflare.com → R2 Object Storage → 버킷 생성(예: hamkke-media).
# 1) R2_BUCKET_NAME - 생성한 버킷 이름 그대로.
# 2) R2_ACCOUNT_ID - Cloudflare 대시보드 우측 상단/R2 개요 페이지에 표시되는 계정 ID.
# 3) R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY - R2 개요 페이지 "Manage API tokens"
#    → "Create Account API token"(권한: Object Read & Write, 해당 버킷으로
#    스코프 제한 권장). 발급 직후에만 Secret이 보이니 그때 바로 복사.
# R2_ENDPOINT는 계정 ID로 조합되므로 R2_ACCOUNT_ID만 있으면 코드에서 구성한다
# (https://<ACCOUNT_ID>.r2.cloudflarestorage.com).
R2_BUCKET_NAME=""
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# --- Phase 2: FCM 웹 푸시(터치·새 메시지 알림) ---
# console.firebase.google.com → 프로젝트 생성 → 웹 앱 추가.
# 1) NEXT_PUBLIC_FIREBASE_* - 프로젝트 설정(톱니바퀴) → 일반 탭 → 웹 앱 SDK
#    설정 값(config 객체)을 그대로.
# 2) NEXT_PUBLIC_FIREBASE_VAPID_KEY - 프로젝트 설정 → Cloud Messaging 탭 →
#    "웹 구성" → "웹 푸시 인증서"에서 키 쌍 생성/확인.
# 3) FIREBASE_ADMIN_* - 프로젝트 설정 → 서비스 계정 탭 → "새 비공개 키 생성"
#    으로 받은 JSON 파일에서 project_id/client_email/private_key 세 필드를
#    그대로 옮겨 담는다(서버 전용, 클라이언트에 노출 금지). private_key는
#    JSON 안에서 줄바꿈이 \n으로 이스케이프되어 있는데 그대로 큰따옴표
#    안에 붙여넣으면 된다.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

FIREBASE_ADMIN_PROJECT_ID=""
FIREBASE_ADMIN_CLIENT_EMAIL=""
FIREBASE_ADMIN_PRIVATE_KEY=""

# --- Phase 5: Stripe 구독 결제 ---
# dashboard.stripe.com 가입/로그인 → 테스트 모드로 시작 권장(화면 우측 상단
# "테스트 모드" 토글, 실제 결제 없이 카드 4242 4242 4242 4242 등으로 검증 가능).
# 1) STRIPE_SECRET_KEY, NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY - 개발자 → API 키
#    페이지에서 각각 "비밀 키"(sk_test_...), "게시 가능한 키"(pk_test_...).
# 2) STRIPE_PREMIUM_PRICE_ID - 상품 카탈로그 → 상품 추가(예: "Hamkke Premium")
#    → 가격 추가(월간 구독, 정기 결제)로 만든 뒤 그 Price의 ID(price_...).
#    Subscription은 Space 단위(User 아님, ARCHITECTURE.md §6)라 가격은 이거
#    하나만 있으면 된다.
# 3) STRIPE_WEBHOOK_SECRET - 로컬 개발 중엔 Stripe CLI로 받는다:
#    `stripe login` 후 `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
#    를 실행하면 터미널에 whsec_...가 출력된다(이 커맨드를 계속 켜둬야 로컬에서
#    webhook을 받는다). 실제 배포 후엔 대시보드 → 개발자 → Webhooks에서
#    엔드포인트를 등록하고 그때 발급되는 시크릿으로 교체.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PREMIUM_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""
# 유료 플랜을 팔고 있는지. "1"일 때만 결제 버튼이 보이고 결제를 시작할 수 있다.
# 비우면 닫힌 상태로, 무료 한도는 그대로 두고 "프리미엄은 곧 열려요"로 안내한다
# (2026-10-04 결정: 결제는 만들어 두되 닫은 채 출시). 열 때는 Play 대체 결제 등록,
# Open-Meteo 유료 플랜 가입을 함께 끝낸 뒤 운영 환경변수에 "1"을 넣는다.
# 로컬에서 결제를 확인할 때만 "1". e2e가 띄우는 서버에는 playwright.config.ts가 "1"을
# 주지만, 이미 떠 있는 개발 서버를 쓰면 그 서버를 PREMIUM_OPEN=1로 띄워야 한다.
PREMIUM_OPEN=""

# --- 한국 대체 결제: Play 개발자 API 거래 보고(src/server/play-reporting.ts) ---
# Play 앱에서 시작한 결제·환불을 Google Play에 보고할 때만 쓴다(웹 결제는 보고하지 않음).
# 유료 플랜을 열기 전(PREMIUM_OPEN 비어 있음)에는 비워 둬도 된다. 앱 결제가 들어왔는데
# 비어 있으면 웹훅이 500으로 실패하고 Stripe가 다시 보낸다(그사이 채우면 됨).
# 1) GOOGLE_PLAY_PACKAGE_NAME - 앱 패키지 이름(capacitor.config.ts appId)
# 2) Google Cloud 콘솔 → 서비스 계정 만들기 → 키 추가(JSON) → 그 파일의 client_email과
#    private_key를 아래 두 값에 넣는다(private_key의 줄바꿈은 \n 그대로 한 줄로).
# 3) Play Console → 사용자 및 권한 → 위 서비스 계정 이메일을 초대하고 앱 권한을 준다
#    (주문·구독 관리 계열 - 정확한 권한 이름은 초대 화면에서 확인). 한국 대체 결제
#    프로그램 등록도 Play Console에서 한다.
GOOGLE_PLAY_PACKAGE_NAME="com.hamkke.app"
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY=""
