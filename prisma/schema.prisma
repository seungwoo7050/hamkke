// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SpaceStatus {
  pending
  active
}

model Space {
  id        String      @id @default(cuid())
  status    SpaceStatus @default(pending)
  createdAt DateTime    @default(now())

  // 초대코드 페어링(docs/ARCHITECTURE.md §3) - 24시간 TTL
  inviteCode          String   @unique
  inviteCodeExpiresAt DateTime

  // 구독 주체(ARCHITECTURE.md §6)의 Stripe Customer. 구독이 생기기 전에도
  // 기억해 두어 두 사람이 따로 결제를 시작해도 같은 Customer를 쓰게 한다.
  stripeCustomerId String? @unique

  members        User[]
  messages       Message[]
  touches        Touch[]
  geofences      Geofence[]
  meetupPins     MeetupPin[]
  calendarEvents CalendarEvent[]
  moments        Moment[]
  anniversaries  Anniversary[]
  countdowns     Countdown[]
  capsules       Capsule[]
  subscription   Subscription?
  dailyAnswers   DailyAnswer[]
  flights        Flight[]
}

// Auth.js Prisma 어댑터 계약(@auth/prisma-adapter)을 따른다. 필드명은 어댑터가
// 그대로 쿼리하는 이름이라 임의로 바꾸지 않는다(PRD.md의 avatarUrl → image로
// 대응, docs/COMMIT_PLAN.md Phase 1 각주 참고).
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  timezone String?

  // 옵트인 위치공유(docs/ARCHITECTURE.md §5) - 기본 꺼짐, 사용자가 명시적으로
  // 켜야 하고 언제든 끌 수 있어야 한다.
  locationSharingEnabled Boolean @default(false)
  /// 화면·알림 언어(PRD §3.8) - "ko" | "en". 비어 있으면 기기 언어 → 한국어.
  /// 사람마다 따로라 두 사람의 언어가 다를 수 있다.
  locale                 String?
  /// 기기 언어(브라우저가 동기화한 지원 언어 중 하나). locale을 고르지 않은 사람의
  /// 푸시·서버 문구를 화면과 같은 언어로 만들 때 쓴다 - 화면은 요청마다 Accept-Language로
  /// 정하지만 푸시는 요청 밖에서 만들어져 기기 언어를 따로 알아 둬야 한다.
  deviceLocale           String?

  spaceId String?
  space   Space?  @relation(fields: [spaceId], references: [id])

  accounts        Account[]
  sessions        Session[]
  sentMessages    Message[]
  sentTouches     Touch[]
  pushTokens      PushToken[]
  locationPings   LocationPing[]
  geofences       Geofence[]
  createdEvents   CalendarEvent[]
  uploadedMoments Moment[]
  sentCapsules    Capsule[]
  dailyAnswers    DailyAnswer[]
  flights         Flight[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

enum MessageType {
  text
  image
  voice
}

model Message {
  id        String      @id @default(cuid())
  spaceId   String
  senderId  String
  type      MessageType @default(text)
  // text 타입은 본문, image/voice 타입은 R2에 업로드된 미디어의 signed URL 경로.
  content   String
  // image/voice의 R2 파일 크기(바이트) - 스페이스 저장 용량 상한 계산용. text는 null.
  mediaSize Int?
  createdAt DateTime    @default(now())
  // 상대방이 읽은 시각. 2인 전용 Space라 수신자가 항상 1명이라 단일 필드로 충분.
  readAt    DateTime?

  space  Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id])

  @@index([spaceId, createdAt])
}

// "생각하고 있어" 원탭 알림(PRD.md §3.2). 내용 없이 보낸 시각만 있으면 된다.
model Touch {
  id        String   @id @default(cuid())
  spaceId   String
  senderId  String
  createdAt DateTime @default(now())

  space  Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id])

  @@index([spaceId, createdAt])
}

// 한 사용자가 여러 브라우저/기기에서 알림을 받을 수 있어 User 필드가 아니라
// 별도 모델로 둔다. 토큰은 FCM이 주기적으로 갱신하므로 만료된 토큰은 발송
// 실패 시(messaging/registration-token-not-registered) 삭제한다.
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 위치공유(PRD.md §3.3)는 옵트인 기능이라 매번 최신 좌표만 갱신하지 않고
// 스로틀링된 스냅샷을 계속 쌓는다(ARCHITECTURE.md §4 - 만남 지도 등 히스토리
// 활용을 염두에 둠). 최신 위치는 userId+capturedAt으로 정렬해 조회한다.
model LocationPing {
  id         String   @id @default(cuid())
  userId     String
  lat        Float
  lng        Float
  accuracy   Float?
  capturedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, capturedAt])
}

// 사용자가 등록한 "집/회사/공항" 같은 의미 있는 장소(PRD.md §3.3). 본인이
// 이 지점 반경 안에 들어오면 상대에게 도착 알림이 간다. isInside는 마지막
// 확인 시점 상태를 저장해 "안→밖→안" 재진입 때만 다시 알리고 반경 안에
// 머무는 동안 중복 알림을 보내지 않기 위한 것.
model Geofence {
  id        String   @id @default(cuid())
  spaceId   String
  userId    String
  label     String
  lat       Float
  lng       Float
  radiusM   Int      @default(200)
  isInside  Boolean  @default(false)
  createdAt DateTime @default(now())

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([spaceId])
}

// 실제로 같이 만났던 장소를 기록하는 타임라인 핀(PRD.md §3.3). date는 기록
// 시각(createdAt)과 달리 "실제로 만난 날짜"라 나중에 지난 만남을 소급
// 기록할 수도 있다.
model MeetupPin {
  id        String   @id @default(cuid())
  spaceId   String
  lat       Float
  lng       Float
  label     String
  date      DateTime
  createdAt DateTime @default(now())

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId, date])
}

// 공유 캘린더(PRD.md §3.4). startAt/endAt은 UTC로 저장하고, 생성 시점의
// 작성자 timezone을 함께 남겨 "어느 기준 시간대로 입력했는지"를 보존한다
// (조회 시 각자 User.timezone으로 다시 변환해서 보여준다 - §5 시차 위젯과
// 동일한 IANA 타임존 유틸 재사용).
model CalendarEvent {
  id        String   @id @default(cuid())
  spaceId   String
  createdBy String
  title     String
  startAt   DateTime
  endAt     DateTime
  timezone  String
  createdAt DateTime @default(now())

  space   Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  creator User  @relation(fields: [createdBy], references: [id])

  @@index([spaceId, startAt])
}

// "오늘의 사진" 피드(PRD.md §3.4). mediaUrl은 PRD 명명 그대로 두지만 실제
// 값은 Message의 image 타입과 동일하게 R2 오브젝트 키다 - 응답 시점에만
// presigned GET URL로 변환한다(ARCHITECTURE.md §10, 영구 public URL 금지).
// 기억에 올린 파일의 종류. 업로드를 신고한 형식이 아니라 R2에 실제로 올라간
// Content-Type으로 정한다(moment.create).
enum MediaKind {
  image
  video
}

model Moment {
  id         String    @id @default(cuid())
  spaceId    String
  uploaderId String
  mediaUrl   String
  mediaKind  MediaKind @default(image)
  // R2 파일 크기(바이트) - 스페이스 저장 용량 상한 계산용.
  mediaSize  Int?
  caption    String?
  createdAt  DateTime  @default(now())

  space    Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  uploader User  @relation(fields: [uploaderId], references: [id])

  @@index([spaceId, createdAt])
}

// 기념일 트래커(PRD.md §3.4). recurring이 true면 매년 같은 월/일에 반복되는
// 기념일(생일 등), false면 date 자체가 그 해에만 의미 있는 단발성 기념일이다.
// 정확한 시각 push 스케줄러는 이 프로젝트에 아직 없어(docs/*.md에 크론
// 인프라 언급 없음) "다가오는 기념일"은 조회 시점에 계산해서 보여준다.
model Anniversary {
  id        String   @id @default(cuid())
  spaceId   String
  title     String
  date      DateTime
  recurring Boolean  @default(true)
  createdAt DateTime @default(now())

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId])
}

// 다음 만남까지 카운트다운(PRD.md §3.4). Anniversary와 달리 반복 개념
// 없이 targetDate 하나만 가진 1회성 목표일이다("다음 여행" 같은).
model Countdown {
  id         String   @id @default(cuid())
  spaceId    String
  title      String
  targetDate DateTime
  createdAt  DateTime @default(now())

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId])
}

// 예약 메시지/캡슐 노트(PRD.md §3.4). deliverAt이 지나기 전에는 상대에게
// content를 숨긴다("아직 도착하지 않았어요"만 보여줌). deliveredAt은
// 상대가 실제로 처음 열람한 시각 - 정확한 시각 push는 스케줄러가 없어
// 지원하지 않고(Phase 4 각주), 상대가 조회할 때 deliverAt을 지났는지만
// 확인하는 pull 방식이다.
model Capsule {
  id          String    @id @default(cuid())
  spaceId     String
  senderId    String
  content     String
  deliverAt   DateTime
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())

  space  Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id])

  // "착륙하면 열리는 편지"(PRD §3.3.1). deliverAt은 이 항공편의 가장 믿을 만한
  // 도착 시각에 맞춰 두고(항공편 시각을 고치면 같이 옮김), 배달 판정은 그대로
  // deliverAt 기준 pull이다. 항공편을 지우면 연결만 끊고 편지는 남는다.
  flightId String?
  flight   Flight? @relation(fields: [flightId], references: [id], onDelete: SetNull)

  @@index([spaceId, deliverAt])
}

// 구독 주체는 User가 아니라 Space(ARCHITECTURE.md §6) - 한쪽이 결제하면
// 둘 다 프리미엄 혜택을 받는다. status는 Stripe subscription status를
// 그대로 저장한다(active/past_due/canceled/trialing 등, Stripe가 값을
// 늘려도 깨지지 않게 Prisma enum이 아닌 문자열로 둔다).
model Subscription {
  id                   String   @id @default(cuid())
  spaceId              String   @unique
  stripeCustomerId     String   @unique
  stripeSubscriptionId String   @unique
  plan                 String
  status               String
  currentPeriodEnd     DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
}

// 하루 한 질문 답변(PRD §3.2). 질문 본문은 DB가 아니라 앱 내장 목록
// (src/lib/daily-question.ts)이라 questionKey로만 참조한다 - 콘텐츠 운영
// 없이 목록 순서대로 순환한다. 두 사람이 서로 다른 시간대에 있어 "오늘"을
// 로컬 기준으로 맞출 수 없으므로 dateKey는 UTC 날짜(YYYY-MM-DD)다.
model DailyAnswer {
  id          String   @id @default(cuid())
  spaceId     String
  userId      String
  questionKey String
  dateKey     String
  content     String
  createdAt   DateTime @default(now())

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([spaceId, userId, dateKey])
  @@index([spaceId, dateKey])
}

enum FlightStatus {
  scheduled
  departed
  landed
  cancelled
}

enum FlightSource {
  manual
  barcode
  api
}

// 비행(PRD §3.3.1). 지금은 예정 시각만 채운다(무료 범위). 실제 시각·status는
// 유료 항공편 API 단계에서 채울 자리 - 화면은 src/lib/flight.ts의 "가장 믿을
// 만한 시각"만 읽으므로 그때 화면 코드는 바뀌지 않는다. 시각은 UTC로 저장하고,
// 입력은 각 공항 현지 시각으로 받는다(공항 시간대는 src/lib/airports.ts).
model Flight {
  id                   String       @id @default(cuid())
  spaceId              String
  travelerId           String
  flightNumber         String
  /// 출발 공항 현지 날짜 - 날짜 필드 관례대로 UTC 자정으로 저장
  departureDate        DateTime
  fromIata             String
  toIata               String
  scheduledDepartureAt DateTime
  scheduledArrivalAt   DateTime
  actualDepartureAt    DateTime?
  actualArrivalAt      DateTime?
  status               FlightStatus @default(scheduled)
  source               FlightSource @default(manual)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  space    Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  traveler User      @relation(fields: [travelerId], references: [id], onDelete: Cascade)
  capsules Capsule[]

  @@index([spaceId, scheduledDepartureAt])
}

// 요청 횟수 제한 기록(ARCHITECTURE.md §7). bucket은 한도 종류(예: "chat.send"),
// subject는 세는 단위(사용자 ID·IP·이메일 등). 가장 긴 창이 지난 기록은 기록할
// 때마다 정리한다 - 스케줄러 없이 테이블이 커지지 않게.
model RateLimitHit {
  id        String   @id @default(cuid())
  bucket    String
  subject   String
  createdAt DateTime @default(now())

  @@index([bucket, subject, createdAt])
  @@index([bucket, createdAt])
}
