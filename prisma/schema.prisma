// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SpaceStatus {
  pending
  active
}

model Space {
  id        String      @id @default(cuid())
  status    SpaceStatus @default(pending)
  createdAt DateTime    @default(now())

  // 초대코드 페어링(docs/ARCHITECTURE.md §3) — 24시간 TTL
  inviteCode          String   @unique
  inviteCodeExpiresAt DateTime

  members    User[]
  messages   Message[]
  touches    Touch[]
  geofences  Geofence[]
  meetupPins MeetupPin[]
}

// Auth.js Prisma 어댑터 계약(@auth/prisma-adapter)을 따른다. 필드명은 어댑터가
// 그대로 쿼리하는 이름이라 임의로 바꾸지 않는다(PRD.md의 avatarUrl → image로
// 대응, docs/COMMIT_PLAN.md Phase 1 각주 참고).
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  timezone String?

  // 옵트인 위치공유(docs/ARCHITECTURE.md §5) — 기본 꺼짐, 사용자가 명시적으로
  // 켜야 하고 언제든 끌 수 있어야 한다.
  locationSharingEnabled Boolean @default(false)

  spaceId String?
  space   Space?  @relation(fields: [spaceId], references: [id])

  accounts      Account[]
  sessions      Session[]
  sentMessages  Message[]
  sentTouches   Touch[]
  pushTokens    PushToken[]
  locationPings LocationPing[]
  geofences     Geofence[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

enum MessageType {
  text
  image
  voice
}

model Message {
  id        String      @id @default(cuid())
  spaceId   String
  senderId  String
  type      MessageType @default(text)
  // text 타입은 본문, image/voice 타입은 R2에 업로드된 미디어의 signed URL 경로.
  content   String
  createdAt DateTime    @default(now())
  // 상대방이 읽은 시각. 2인 전용 Space라 수신자가 항상 1명이라 단일 필드로 충분.
  readAt    DateTime?

  space  Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id])

  @@index([spaceId, createdAt])
}

// "생각하고 있어" 원탭 알림(PRD.md §3.2). 내용 없이 보낸 시각만 있으면 된다.
model Touch {
  id        String   @id @default(cuid())
  spaceId   String
  senderId  String
  createdAt DateTime @default(now())

  space  Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id])

  @@index([spaceId, createdAt])
}

// 한 사용자가 여러 브라우저/기기에서 알림을 받을 수 있어 User 필드가 아니라
// 별도 모델로 둔다. 토큰은 FCM이 주기적으로 갱신하므로 만료된 토큰은 발송
// 실패 시(messaging/registration-token-not-registered) 삭제한다.
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 위치공유(PRD.md §3.3)는 옵트인 기능이라 매번 최신 좌표만 갱신하지 않고
// 스로틀링된 스냅샷을 계속 쌓는다(ARCHITECTURE.md §4 — 만남 지도 등 히스토리
// 활용을 염두에 둠). 최신 위치는 userId+capturedAt으로 정렬해 조회한다.
model LocationPing {
  id         String   @id @default(cuid())
  userId     String
  lat        Float
  lng        Float
  accuracy   Float?
  capturedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, capturedAt])
}

// 사용자가 등록한 "집/회사/공항" 같은 의미 있는 장소(PRD.md §3.3). 본인이
// 이 지점 반경 안에 들어오면 상대에게 도착 알림이 간다. isInside는 마지막
// 확인 시점 상태를 저장해 "안→밖→안" 재진입 때만 다시 알리고 반경 안에
// 머무는 동안 중복 알림을 보내지 않기 위한 것.
model Geofence {
  id        String   @id @default(cuid())
  spaceId   String
  userId    String
  label     String
  lat       Float
  lng       Float
  radiusM   Int      @default(200)
  isInside  Boolean  @default(false)
  createdAt DateTime @default(now())

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([spaceId])
}

// 실제로 같이 만났던 장소를 기록하는 타임라인 핀(PRD.md §3.3). date는 기록
// 시각(createdAt)과 달리 "실제로 만난 날짜"라 나중에 지난 만남을 소급
// 기록할 수도 있다.
model MeetupPin {
  id        String   @id @default(cuid())
  spaceId   String
  lat       Float
  lng       Float
  label     String
  date      DateTime
  createdAt DateTime @default(now())

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId, date])
}
