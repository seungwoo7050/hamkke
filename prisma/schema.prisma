// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SpaceStatus {
  pending
  active
}

model Space {
  id        String      @id @default(cuid())
  status    SpaceStatus @default(pending)
  createdAt DateTime    @default(now())

  // 초대코드 페어링(docs/ARCHITECTURE.md §3) — 24시간 TTL
  inviteCode          String   @unique
  inviteCodeExpiresAt DateTime

  members  User[]
  messages Message[]
  touches  Touch[]
}

// Auth.js Prisma 어댑터 계약(@auth/prisma-adapter)을 따른다. 필드명은 어댑터가
// 그대로 쿼리하는 이름이라 임의로 바꾸지 않는다(PRD.md의 avatarUrl → image로
// 대응, docs/COMMIT_PLAN.md Phase 1 각주 참고).
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  timezone String?

  spaceId String?
  space   Space?  @relation(fields: [spaceId], references: [id])

  accounts     Account[]
  sessions     Session[]
  sentMessages Message[]
  sentTouches  Touch[]
  pushTokens   PushToken[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

enum MessageType {
  text
  image
  voice
}

model Message {
  id        String      @id @default(cuid())
  spaceId   String
  senderId  String
  type      MessageType @default(text)
  // text 타입은 본문, image/voice 타입은 R2에 업로드된 미디어의 signed URL 경로.
  content   String
  createdAt DateTime    @default(now())
  // 상대방이 읽은 시각. 2인 전용 Space라 수신자가 항상 1명이라 단일 필드로 충분.
  readAt    DateTime?

  space  Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id])

  @@index([spaceId, createdAt])
}

// "생각하고 있어" 원탭 알림(PRD.md §3.2). 내용 없이 보낸 시각만 있으면 된다.
model Touch {
  id        String   @id @default(cuid())
  spaceId   String
  senderId  String
  createdAt DateTime @default(now())

  space  Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id])

  @@index([spaceId, createdAt])
}

// 한 사용자가 여러 브라우저/기기에서 알림을 받을 수 있어 User 필드가 아니라
// 별도 모델로 둔다. 토큰은 FCM이 주기적으로 갱신하므로 만료된 토큰은 발송
// 실패 시(messaging/registration-token-not-registered) 삭제한다.
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
